CONFIG_IDF_TARGET="esp32s3"

# Wi-Fi and the platform: fill in with `idf.py menuconfig`.
# The values land in the local sdkconfig, which is not committed.
CONFIG_EMBED_WIFI_SSID=""
CONFIG_EMBED_WIFI_PASSWORD=""

CONFIG_EMBED_COGITOR_IOT_PRODUCT_ID="main"
CONFIG_EMBED_COGITOR_IOT_DEVICE_ID="esp32-s3-light"
CONFIG_EMBED_COGITOR_IOT_HOST=""
CONFIG_EMBED_COGITOR_IOT_ACCESS_TOKEN=""
CONFIG_EMBED_COGITOR_IOT_USE_TLS=n
CONFIG_EMBED_COGITOR_IOT_PORT=0
CONFIG_EMBED_COGITOR_IOT_TOPIC_SHORT=y

# Telemetry every 10 seconds; no SPIFFS partition in this example.
CONFIG_EMBED_METRICS_INTERVAL_MS=10000
CONFIG_EMBED_METRICS_ENABLE_STORAGE=n

CONFIG_EMBED_MQTT_RECONNECT_INTERVAL_MS=5000
CONFIG_EMBED_MQTT_KEEPALIVE=60

CONFIG_EMBED_LED_STRIP=y
CONFIG_EMBED_LED_STRIP_MAX=2
CONFIG_EMBED_LED_STRIP_DEFAULT_BRIGHTNESS=32

# Wi-Fi + MQTT + TLS do not fit the default 1 MB app partition.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_HARDWARE_SHA=n
